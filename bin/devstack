#!/usr/bin/env bash
# bin/devstack - Main entry point for Dev Stack CLI

set -uo pipefail

# Minimal terminal safety - don't aggressively reset stty
trap 'printf "\033[0m\033[?25h" 2>/dev/null || true' EXIT INT TERM

# Resolve the actual script location, following symlinks
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Source libraries in order (detect.sh guarded by _DETECT_SH_SOURCED)
source "$PROJECT_ROOT/lib/config.sh" || { echo "Error: Failed to load config.sh" >&2; exit 1; }
source "$PROJECT_ROOT/lib/detect.sh" || { echo "Error: Failed to load detect.sh" >&2; exit 1; }
source "$PROJECT_ROOT/lib/ui.sh" || { echo "Error: Failed to load ui.sh" >&2; exit 1; }
source "$PROJECT_ROOT/lib/services.sh" || { echo "Error: Failed to load services.sh" >&2; exit 1; }
source "$PROJECT_ROOT/lib/guides.sh" || { echo "Error: Failed to load guides.sh" >&2; exit 1; }
source "$PROJECT_ROOT/lib/php_ext.sh" || { echo "Error: Failed to load php_ext.sh" >&2; exit 1; }
source "$PROJECT_ROOT/lib/menu.sh" || { echo "Error: Failed to load menu.sh" >&2; exit 1; }

# The sourced libs turn on 'set -e' on their own; disable errexit here so a
# transient command failure (e.g. composer/php momentarily missing) does NOT
# abort the whole CLI before the menu even opens. Keep -u/-o pipefail.
set +e

# Change to project root for docker compose commands
cd "$PROJECT_ROOT" 2>/dev/null || { echo "Error: Cannot change to project root: $PROJECT_ROOT" >&2; exit 1; }

# Load .env if exists
if [[ -f ".env" ]]; then
    set -a
    source ".env"
    set +a
    echo -e "  ${GREEN}✅${NC} .env loaded from $(pwd)/.env"
else
    # .env belum ada — tampilkan instruksi & hentikan CLI
    echo -e "  ${RED}❌${NC} .env tidak ditemukan!"
    echo ""
    echo "  📄 File konfigurasi $(pwd)/.env belum tersedia."
    echo ""
    echo "  Langkah yang harus dilakukan:"
    echo ""
    echo "  1. Salin file contoh:"
    echo "       cp .env.example .env"
    echo ""
    echo "  2. Edit .env sesuai kebutuhan:"
    echo "     - Ubah port jika ada konflik (MYSQL_PORT, POSTGRES_PORT, dll.)"
    echo "     - Ganti password database (MYSQL_ROOT_PASSWORD, POSTGRES_PASSWORD, MONGODB_PASSWORD)"
    echo "     - Sesuaikan credentials MinIO & RabbitMQ"
    echo ""
    echo "  3. Simpan, lalu jalankan ulang:"
    echo "       ./bin/devstack"
    echo ""
    echo "  💡 Gunakan editor favorit Anda:"
    echo "       nano .env"
    echo "       vim .env"
    echo "       code .env"
    echo ""
    exit 1
fi

# Run detection
detect_all

# Help mode
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Dev Stack CLI"
    echo ""
    echo "Usage: devstack [options]"
    echo ""
    echo "Options:"
    echo "  --check, -c    Run system check and exit"
    echo "  --reset, -r    Reset terminal state and exit"
    echo "  --debug        Show diagnostic info before starting menu"
    echo "  --help, -h     Show this help"
    echo ""
    echo "With no options, starts the interactive menu."
    exit 0
fi

# Reset terminal mode (useful if terminal got stuck from a previous run)
if [[ "${1:-}" == "--reset" || "${1:-}" == "-r" ]]; then
    echo "Resetting terminal..."
    printf "\033c" 2>/dev/null || true
    sleep 1
    echo "Done. If it still looks broken, run: reset"
    exit 0
fi

# Non-hanging diagnostic mode (safe for server troubleshooting)
if [[ "${1:-}" == "--check" || "${1:-}" == "-c" ]]; then
    safe_clear
    print_header "Dev Stack — System Check"
    echo ""
    print_detection_summary
    echo ""
    echo -e "  ${CYAN}Docker daemon reachable:${NC} $(docker_safe info >/dev/null 2>&1 && echo -e "${GREEN}yes${NC}" || echo -e "${RED}no${NC}")"
    echo ""
    exit 0
fi

# Guide paths
DOCKER_GUIDE="docker-installation.md"
DEVENV_GUIDE="development-environment-installation.md"

# Check Docker - fatal, show guide and exit
if [[ "$HAS_DOCKER" == false ]]; then
    ensure_network &>/dev/null || true
    guide_file=$(generate_docker_guide "$DOCKER_GUIDE")
    safe_clear
    print_header "Prerequisites Not Met"
    echo ""
    echo "  Docker is not installed on this system."
    echo ""
    echo "  Installation guide created: $guide_file"
    echo "  Location: $(pwd)/$DOCKER_GUIDE"
    echo ""
    echo "  Please read and run the instructions in that file,"
    echo "  then run './bin/devstack' again."
    echo ""
    read -rp "  Press Enter to exit..." || true
    exit 0
fi

# Check mise - non-fatal, generate guide but continue
if [[ "$HAS_MISE" == false ]]; then
    guide_file=$(generate_devenv_guide "$DEVENV_GUIDE")
    safe_clear
    print_header "Development Runtime Not Available"
    echo ""
    echo "  mise (tool installer) is not installed."
    echo "  PHP ${MISE_PHP_VERSION} / Node ${MISE_NODE_VERSION} / Python ${MISE_PYTHON_VERSION}"
    echo "  will not be available via mise."
    echo ""
    echo "  Installation guide created: $guide_file"
    echo "  Location: $(pwd)/$DEVENV_GUIDE"
    echo ""
    echo "  You can still use this CLI to manage Docker services,"
    echo "  but PHP/Node.js/Python development will require"
    echo "  installing runtimes via mise or manually."
    echo ""
    echo "  Continuing to main menu..."
    echo ""
    read -rp "  Press Enter to continue..." || true
fi

# Ensure network exists
ensure_network

# Debug mode - show what's happening
if [[ "${1:-}" == "--debug" ]]; then
    echo "DEBUG: Interactive terminal check..."
    echo "  stdin TTY: $([[ -t 0 ]] && echo yes || echo no)"
    echo "  stdout TTY: $([[ -t 1 ]] && echo yes || echo no)"
    echo "  HAS_DOCKER: $HAS_DOCKER"
    echo "  HAS_MISE: $HAS_MISE"
    echo "  Starting menu..."
fi

# Check if we have an interactive terminal before starting menu
if ! is_interactive; then
    echo "Error: This CLI requires an interactive terminal (TTY)."
    echo "Please run it directly in a terminal, not via pipe or script."
    exit 1
fi

# Startup banner - always visible
clear
echo ""
echo -e "  ${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "  ${GREEN}🐳  Dev Stack Manager v1.0  -  Starting...${NC}"
echo -e "  ${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Start menu
run_menu
